title: $:/plugins/rimir/work-focus/recipes/tag
tags: $:/tags/rimir/work-focus/recipe
wf.name: tag
caption: Add or remove a tag
wf.mark: <$text text={{{ [function[wf.tag-text]] }}}/>
wf.hint: <$text text={{{ [function[wf.tag-text]] }}}/>

