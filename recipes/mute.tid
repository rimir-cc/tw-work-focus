title: $:/plugins/rimir/work-focus/recipes/mute
tags: $:/tags/rimir/work-focus/recipe
wf.name: mute
caption: Mute
wf.mark: 🔕 until <$text text={{{ [function[wf.until]] :map[function[wf.short-day],<currentTiddler>] }}}/>
wf.hint: hidden until <$text text={{{ [function[wf.until]] :map[function[wf.resolve],<currentTiddler>format:date<wf-day8-format>] }}}/>

<!-- mutes the item in the tab of the area it was dragged from -->
<$let until={{{ [function[wf.until]] }}} day={{{ [wf-date<until>,[20000101]] }}} tab={{{ [function[wf.tab-of],<area>] }}}>
<$action-setfield $tiddler="$:/rimir/work-focus/mutes" text={{{ [function[wf.mutes-with],<tab>,<item>,<day>] }}} type="application/json"/>
</$let>
