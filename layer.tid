title: $:/plugins/rimir/work-focus/layer
tags: $:/tags/PageTemplate
type: text/vnd.tiddlywiki

\whitespace trim
\import $:/plugins/rimir/work-focus/engine
<%if [[$:/config/rimir/work-focus/enabled]get[text]trim[]match[yes]] %>
<$wf-ring-layer>
<div class={{{ wf-layer [[wf-pos-]addsuffix<wf.position>] [{$:/palette}get[color-scheme]match[dark]then[wf-scheme-dark]] +[join[ ]] }}}>
<$keyboard key="escape" actions=<<wf-close>> tag="div" class="wf-keys">
<$eventcatcher selector=".wf-item" $click=<<wf-catch>> tag="div" class="wf-stack">
{{||$:/plugins/rimir/work-focus/dock}}
<%if [[$:/temp/rimir/work-focus/open]get[text]match[yes]] %>
{{||$:/plugins/rimir/work-focus/panel}}
<%endif%>
</$eventcatcher>
</$keyboard>
</div>
</$wf-ring-layer>
<%endif%>
